# MatchIQ — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg2://matchiq:matchiq@localhost:5432/matchiq

# ─── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
# APP_ENV=production
APP_VERSION=0.1.0
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# ─── ML Model ──────────────────────────────────────────────────────────────────
# Directory containing best_model.joblib and feature_metadata.json
MODEL_DIR=ml/models

# ─── CORS ──────────────────────────────────────────────────────────────────────
# JSON array of allowed origins for the API
CORS_ORIGINS=["http://localhost:5173","http://localhost:80","http://localhost:3000"]

# ─── Frontend ──────────────────────────────────────────────────────────────────
# In Docker: http://backend:8000, in dev: leave empty (uses Vite proxy)
# VITE_API_URL=http://localhost:8000
